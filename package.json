{
  "name": "@abc-protocol/bundled-extension",
  "version": "0.13.0",
  "description": "Bundled extension server: memory/history tools + web-fetch/brave-search + image generate/edit, served in-process over the abc protocol.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "manifest.yaml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "biome check .",
    "test": "vitest run",
    "check:fix": "biome check --fix .",
    "check:types": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@abc-protocol/sdk": "github:abcp-sdk/abc-protocol-typescript#v3.7.0",
    "@ai-sdk/openai-compatible": "^3.0.34",
    "@types/turndown": "^5.0.5",
    "ai": "^7.0.73",
    "htmlparser2": "^10.0.0",
    "turndown": "^7.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
